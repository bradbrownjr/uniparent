# Copy to .env and fill in. Never commit .env.

# UniFi OS console/server URL (UniFi OS Server usually listens on 11443, UniFi consoles on 443)
UNIFI_HOST=https://192.168.1.x:11443
# Network app → Integrations → Create New API Key
UNIFI_API_KEY=
UNIFI_SITE=default
# Most self-hosted controllers use a self-signed certificate
UNIFI_VERIFY_TLS=false

# Schedules run in this timezone
TZ=America/New_York

# Keep true when served over HTTPS (required for installing the app on a phone)
COOKIE_SECURE=true
# Set to 1 to try the app with a pretend controller (sign in as admin / demo1234)
UNIPARENT_DEMO=0
